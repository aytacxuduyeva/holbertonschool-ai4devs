{
  "openapi": "3.0.3",
  "info": {
    "title": "Inventory API",
    "description": "Anbar idarəetməsi üçün CRUD əməliyyatlarını dəstəkləyən API.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.inventory-app.com/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "required": ["name", "price"],
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Laptop" },
          "price": { "type": "number", "example": 1200.5 }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Resurs tapılmadı" }
        }
      }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/products": {
      "get": {
        "summary": "Məhsulları siyahıla",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": {
          "200": { "description": "Uğurlu siyahı" },
          "401": { "description": "Token tapılmadı" }
        }
      },
      "post": {
        "summary": "Yarat",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Product" } } }
        },
        "responses": {
          "201": { "description": "Yaradıldı" },
          "400": { "description": "Səhv məlumat" }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "summary": "Oxu",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Tapıldı" },
          "404": { "description": "Tapılmadı" }
        }
      },
      "put": {
        "summary": "Yenilə",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Yeniləndi" }
        }
      },
      "delete": {
        "summary": "Sil",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "204": { "description": "Silindi" }
        }
      }
    }
  }
}
